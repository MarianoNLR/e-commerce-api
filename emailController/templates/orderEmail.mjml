<mjml>
  <mj-body background-color="#f5f5f5">
    <mj-section background-color="#ffffff" padding="20px">
      <mj-column>
        <mj-text font-size="22px" font-weight="bold" color="#333333">
          ¡Gracias por tu compra, {{shipping_info.name}} {{shipping_info.lastName}}!
        </mj-text>
        <mj-text color="#555555" align="center">
          Tu Orden ID es: {{id}}
        </mj-text>
        <mj-text color="#555555" align="center">
          Hemos recibido tu pedido con los siguientes detalles:
        </mj-text>

        <mj-table>
          <tr style="background-color:#efefef;">
            <th style="padding:10px;">Producto</th>
            <th style="padding:10px;">Cantidad</th>
            <th style="padding:10px;">Precio</th>
          </tr>
          {{#each products}}
          <tr>
            <td style="padding:10px; text-align:center;">{{this.product.name}}</td>
            <td style="padding:10px; text-align:center;">{{this.quantity}}</td>
            <td style="padding:10px; text-align:center;">${{multiply this.product.price this.quantity}}</td>
          </tr>
          {{/each}}
        </mj-table>

        <mj-divider border-color="#dddddd" />

        <mj-text font-size="18px" color="#000000">
          <strong>Total: ${{total}}</strong>
        </mj-text>

        <mj-text color="#888888" font-size="14px">
          Fecha de compra: {{createdAt}}
        </mj-text>
        <mj-text color="#aaaaaa" font-size="12px" align="center">
          Te avisaremos a este correo cuando tu orden sea despachada
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section>
      <mj-column>
        <mj-text color="#aaaaaa" font-size="12px">
          © 2025 MNLR — Todos los derechos reservados
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>